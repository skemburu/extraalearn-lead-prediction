{
  "name": "ExtraaLearn Lead Prediction",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [
    7860,
    8501
  ],
  "portsAttributes": {
    "7860": {
      "label": "Flask backend API",
      "onAutoForward": "silent"
    },
    "8501": {
      "label": "Streamlit frontend",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "bash .devcontainer/start.sh > /tmp/start.log 2>&1",
  "postAttachCommand": "bash .devcontainer/make_public.sh > /tmp/public.log 2>&1"
}