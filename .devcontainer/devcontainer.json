{
  "name": "ExtraaLearn Lead Prediction",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {"label": "Flask backend API", "onAutoForward": "silent"},
    "8501": {"label": "Streamlit frontend", "onAutoForward": "silent"}
  },
  "postStartCommand": "bash .devcontainer/start.sh > /tmp/start.log 2>&1"
}
